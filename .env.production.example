# ===== Docker 镜像仓库 (必填) =====
# 阿里云 ACR 示例: REGISTRY=registry.cn-hangzhou.aliyuncs.com/your-namespace/
# Docker Hub 示例: REGISTRY=docker.io/your-username/
REGISTRY=registry.cn-hangzhou.aliyuncs.com/your-namespace/

# ===== 必填：部署前必须修改 =====
# JWT 密钥: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# GitHub OAuth: https://github.com/settings/developers
# Callback URL: https://<你的域名>/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# 域名和 HTTPS（Caddy 自动 Let's Encrypt）
DOMAIN=svg.yourdomain.com
FRONTEND_URL=https://svg.yourdomain.com

# MinIO 对象存储 —— 改掉默认值
MINIO_ACCESS_KEY=change-me-minio-access
MINIO_SECRET_KEY=change-me-minio-secret

# Neo4j 图数据库 —— 改掉默认密码
NEO4J_PASSWORD=change-me-neo4j

# ===== 可选：AI 图标生成 =====
# 支持 OpenAI / DeepSeek / 自定义代理
# DeepSeek 示例：AI_BASE_URL=https://api.deepseek.com/v1  AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o

# ===== 可选：邮件验证码 =====
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=your_password
# SMTP_FROM=noreply@yourdomain.com

# ===== 以下不改 =====
DATABASE_URL=postgres://svguser:svgpass@postgres:5432/svgconverter?sslmode=disable
REDIS_ADDR=redis:6379
MINIO_ENDPOINT=minio:9000
PORT=8080
MAX_FILE_SIZE=10485760
POSTGRES_USER=svguser
POSTGRES_PASSWORD=svgpass
POSTGRES_DB=svgconverter
